#!/bin/sh
set -e
ln -sf /opt/ludworks-browser/ludworks-browser /usr/bin/ludworks-browser
if [ "$1" = "configure" ] && command -v update-alternatives >/dev/null 2>&1; then
  update-alternatives --install /usr/bin/x-www-browser x-www-browser /usr/bin/ludworks-browser 120 || true
  update-alternatives --install /usr/bin/gnome-www-browser gnome-www-browser /usr/bin/ludworks-browser 120 || true
fi
# Chromium's sandbox needs user namespaces: allowed for this binary by the AppArmor profile on
# Ubuntu 24.04+; only where they are switched off entirely does the setuid helper take over.
if [ -x /usr/sbin/apparmor_parser ] && [ -f /etc/apparmor.d/ludworks-browser ]; then
  apparmor_parser -r -T -W /etc/apparmor.d/ludworks-browser >/dev/null 2>&1 || true
fi
if [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = "0" ] || [ "$(cat /proc/sys/user/max_user_namespaces 2>/dev/null)" = "0" ]; then
  chmod 4755 /opt/ludworks-browser/chrome-sandbox
fi
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
exit 0
